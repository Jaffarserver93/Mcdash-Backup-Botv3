# ── MCDash panel ──────────────────────────────────────────────────────────────
# Full URL to your MCDash/VoxelDash instance (no trailing slash)
MCDASH_URL=http://your-server:port

# MCDash API token (shown in Settings → API inside the dashboard)
MCDASH_TOKEN=SnhmcjpqeGZy

# ── Telegram (MTProto user account) ───────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org → API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890

# ── Telegram session (paste here after first login) ───────────────────────────
# Leave blank on first run. After the bot logs in it prints the session string
# in the logs. Copy it here so future restarts skip the OTP prompt.
TELEGRAM_SESSION=

# ── Backup schedule ───────────────────────────────────────────────────────────
# How often to take a backup, in seconds (default: 300 = every 5 minutes)
BACKUP_INTERVAL_SEC=300

# ── HTTP port for OTP entry page and status ───────────────────────────────────
# Render sets PORT automatically — only set this for local/Docker usage
PORT=8080
